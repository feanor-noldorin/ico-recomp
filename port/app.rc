// Windows resources for ico.exe: the icon and the version block.
#include <winver.h>

1 ICON "ico.ico"   // written by pipeline/make_icon.ps1 from the user's ICON0.PNG

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,2,0
 PRODUCTVERSION 0,2,2,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "ICO (PC port)"
      VALUE "FileVersion", "0.2.2"
      VALUE "ProductName", "ICO PC Port"
      VALUE "ProductVersion", "0.2.2"
      VALUE "OriginalFilename", "ico.exe"
      VALUE "InternalName", "ico"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
