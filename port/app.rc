// Windows resources for ico.exe: the icon and the version block.
#include <winver.h>

1 ICON "ico.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "ICO (PC port)"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductName", "ICO PC Port"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "ico.exe"
      VALUE "InternalName", "ico"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
