<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ICO.PC.Port.Setup</AssemblyName>
    <RootNamespace>ICOSetup</RootNamespace>
    <Product>ICO PC Port</Product>
    <Description>ICO PC Port Setup</Description>
    <Version>0.2.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- One self-contained exe, like the P.T. setup: no .NET install needed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- payload.zip = pipeline/, port/, docs/ and the ps3recomp tree. No game data.
       tools/make_release.ps1 builds it; a dev build without it is started
       with the source option pointing at a repo checkout instead. -->
  <ItemGroup Condition="Exists('..\..\build\payload.zip')">
    <EmbeddedResource Include="..\..\build\payload.zip" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
